    description: "The Guardian \u98CE\u683C - \u84DD\u9EC4\u914D\u8272",
    css: `body{font-family:-apple-system, sans-serif;font-size:17px;line-height:1.7;color:#121212;max-width:700px;margin:0 auto;padding:40px;background:#fff;}h1{font-family:-apple-system, sans-serif;font-size:42px;font-weight:700;color:#052962;margin:0 0 24px;}h2{font-family:-apple-system, sans-serif;font-size:32px;font-weight:600;color:#052962;margin:36px 0 16px;border-bottom:2px solid #C70000;padding-bottom:8px;}h3{font-size:20px;font-weight:600;color:#333333;margin:30px 0 12px;}p{margin:8px 0;line-height:1.7;}blockquote{margin:22px 0;padding:16px 18px;border-left:4px solid #C70000;background:#FEC200;color:#052962;font-style:normal;}ul{margin:20px 0;padding-left:30px;}li{margin:12px 0;line-height:1.7;color:#121212;}strong{font-weight:bold;color:#052962;}code{font-family:Consolas,Monaco,monospace;background:#f6f6f6;color:#C70000;padding:2px 6px;border-radius:3px;font-size:0.9em;}hr{border:none;border-top:1px solid #052962;margin:30px 0;}`
  },
  warmDocs: {
    name: "\u7126\u6A59\u6587\u6863",
    description: "\u7126\u6A59\u8272 + \u6E29\u6696\u6587\u6863\u98CE\u683C",
    css: `body{font-family:-apple-system, sans-serif;font-size:16px;line-height:1.8;color:#1A1A1A;max-width:700px;margin:0 auto;padding:40px;background:#FAFAF9;}h1{font-family:-apple-system, sans-serif;font-size:28px;font-weight:700;color:#1A1A1A;margin:0 0 24px;}h2{font-family:-apple-system, sans-serif;font-size:22px;font-weight:700;color:#1A1A1A;margin:36px 0 16px;border-bottom:2px solid #C2410C;padding-bottom:8px;}h3{font-size:20px;font-weight:600;color:#333333;margin:30px 0 12px;}p{margin:8px 0;line-height:1.8;}blockquote{margin:22px 0;padding:16px 18px;border-left:4px solid #C2410C;background:#FFF7ED;color:#1A1A1A;font-style:normal;}ul{margin:20px 0;padding-left:30px;}li{margin:12px 0;line-height:1.8;color:#1A1A1A;}strong{font-weight:bold;color:#C2410C;}code{font-family:Consolas,Monaco,monospace;background:#F5F5F0;color:#C2410C;padding:2px 6px;border-radius:3px;font-size:0.9em;}hr{border:none;border-top:1px solid #E5E5E5;margin:30px 0;}`
  }
};
var VIEW_TYPE_WECHAT_PREVIEW = "wechat-preview";
var WeChatPreviewView = class extends import_obsidian.ItemView {
  constructor(leaf, plugin) {
    super(leaf);
    this.cachedMarkdown = "";
    this.themeStyleEl = null;
    this.plugin = plugin;
    this.currentStyle = plugin.settings.defaultStyle;
  }
  getViewType() {
    return VIEW_TYPE_WECHAT_PREVIEW;
  }
  getDisplayText() {
    return "\u516C\u4F17\u53F7\u9884\u89C8";
  }
  getIcon() {
    return "smartphone";
  }
  async onOpen() {
    const container = this.containerEl.children[1];
    container.empty();
    container.addClass("wechat-publisher-view");
    const header = container.createDiv("wechat-publisher-header");
    const selector = header.createEl("select", {
      cls: "wechat-publisher-style-selector"
    });
    Object.entries(STYLES).forEach(([key, style]) => {
      const option = selector.createEl("option", {
        value: key,
        text: `${style.name} - ${style.description}`
      });
      if (key === this.currentStyle) {
        option.selected = true;
      }
    });
    selector.addEventListener("change", () => {
      console.log("[MDskill] \u4E3B\u9898\u5207\u6362:", selector.value);
      this.currentStyle = selector.value;
      this.updatePreview();
    });
    const actions = header.createDiv("wechat-publisher-actions");
    const copyBtn = actions.createEl("button", {
      text: "\u590D\u5236\u5230\u516C\u4F17\u53F7",
      cls: "wechat-publisher-btn"
    });
    copyBtn.addEventListener("click", () => this.copyToClipboard());
    const exportBtn = actions.createEl("button", {
      text: "\u5BFC\u51FAHTML",
      cls: "wechat-publisher-btn secondary"
    });
    exportBtn.addEventListener("click", () => this.exportHTML());
    const previewContainer = container.createDiv("wechat-publisher-preview");
    this.previewEl = previewContainer.createDiv("wechat-publisher-preview-content");
    this.registerEvent(
      this.app.workspace.on("active-leaf-change", () => {
        this.cacheCurrentMarkdown();
        this.updatePreview();
      })
    );
    this.registerEvent(
      this.app.workspace.on("editor-change", () => {
        if (this.plugin.settings.autoUpdate) {
          this.cacheCurrentMarkdown();
          this.updatePreview();
        }
      })
    );
    this.cacheCurrentMarkdown();
    this.updatePreview();
  }
  async onClose() {
    if (this.themeStyleEl) {
      this.themeStyleEl.remove();
      this.themeStyleEl = null;
    }
  }
  cacheCurrentMarkdown() {
    const activeView = this.app.workspace.getActiveViewOfType(import_obsidian.MarkdownView);
    if (activeView) {
      this.cachedMarkdown = activeView.editor.getValue();
    }
  }
  async updatePreview() {
    if (!this.cachedMarkdown) {
      const activeView = this.app.workspace.getActiveViewOfType(import_obsidian.MarkdownView);
      if (!activeView) {
        this.previewEl.innerHTML = '<p style="color: #999; text-align: center; padding: 40px;">\u8BF7\u6253\u5F00\u4E00\u4E2A Markdown \u6587\u4EF6</p>';
        return;
      }
      this.cachedMarkdown = activeView.editor.getValue();
    }
    console.log("[MDskill] \u66F4\u65B0\u9884\u89C8, \u5F53\u524D\u4E3B\u9898:", this.currentStyle);
    const style = STYLES[this.currentStyle];
    if (!style) {
      this.previewEl.innerHTML = "<p>\u672A\u627E\u5230\u6837\u5F0F</p>";
      return;
    }
    if (this.themeStyleEl) {
      this.themeStyleEl.remove();
    }
    this.themeStyleEl = document.createElement("style");
    this.themeStyleEl.id = "mdskill-theme-style";
    document.head.appendChild(this.themeStyleEl);
    let scopedCSS = style.css.replace(/body\s*\{/g, ".mdskill-preview {").replace(/\}h1\s*\{/g, "}.mdskill-preview h1 {").replace(/\}h2\s*\{/g, "}.mdskill-preview h2 {").replace(/\}h3\s*\{/g, "}.mdskill-preview h3 {").replace(/\}h4\s*\{/g, "}.mdskill-preview h4 {").replace(/\}h5\s*\{/g, "}.mdskill-preview h5 {").replace(/\}h6\s*\{/g, "}.mdskill-preview h6 {").replace(/\}p\s*\{/g, "}.mdskill-preview p {").replace(/\}blockquote\s*\{/g, "}.mdskill-preview blockquote {").replace(/\}code\s*\{/g, "}.mdskill-preview code {").replace(/\}pre\s*\{/g, "}.mdskill-preview pre {").replace(/\}ul\s*\{/g, "}.mdskill-preview ul {").replace(/\}ol\s*\{/g, "}.mdskill-preview ol {").replace(/\}li\s*\{/g, "}.mdskill-preview li {").replace(/\}a\s*\{/g, "}.mdskill-preview a {").replace(/\}img\s*\{/g, "}.mdskill-preview img {").replace(/\}hr\s*\{/g, "}.mdskill-preview hr {").replace(/\}strong\s*\{/g, "}.mdskill-preview strong {").replace(/\}em\s*\{/g, "}.mdskill-preview em {");
    scopedCSS = scopedCSS.replace(/(color|font-size|font-family|line-height|border-bottom|background|padding|margin|font-weight):\s*([^;]+);/g, "$1:$2 !important;");
    this.themeStyleEl.textContent = scopedCSS;
    console.log("[MDskill] \u2705 \u5DF2\u5C06\u6837\u5F0F\u6CE8\u5165\u5230 document.head\uFF0CCSS \u957F\u5EA6:", scopedCSS.length);
    this.previewEl.empty();
    const contentDiv = this.previewEl.createDiv("mdskill-preview");
    const htmlContent = this.convertMarkdownToHTMLOnly(this.cachedMarkdown);
    contentDiv.innerHTML = htmlContent;
    console.log("[MDskill] \u2705 \u9884\u89C8\u66F4\u65B0\u5B8C\u6210");
  }
  convertMarkdownToHTMLOnly(markdown) {
    let html = "";
    const lines = markdown.split("\n");
    let inList = false;
    let listItems = [];
    const flushList = () => {
      if (listItems.length > 0) {
        html += "<ul>" + listItems.join("") + "</ul>";
        listItems = [];
      }
      inList = false;
    };
    for (let i = 0; i < lines.length; i++) {
      let line = lines[i];
      if (line.startsWith("# ")) {
        flushList();
        html += "<h1>" + this.processInline(line.substring(2)) + "</h1>";
        continue;
      }
      if (line.startsWith("## ")) {
        flushList();
        html += "<h2>" + this.processInline(line.substring(3)) + "</h2>";
        continue;
      }
      if (line.startsWith("### ")) {
        flushList();
        html += "<h3>" + this.processInline(line.substring(4)) + "</h3>";
        continue;
      }
      if (line.startsWith("> ")) {
        flushList();
        html += "<blockquote>" + this.processInline(line.substring(2)) + "</blockquote>";
        continue;
      }
      if (line.match(/^[-*+]\s+/)) {
        const content = line.replace(/^[-*+]\s+/, "");
        listItems.push("<li>" + this.processInline(content) + "</li>");
        inList = true;
        continue;
      }
      if (line.match(/^[-*_]{3,}$/)) {
        flushList();
        html += "<hr>";
        continue;
      }
      if (line.trim() === "") {
        flushList();
        continue;
      }
      flushList();
      html += "<p>" + this.processInline(line) + "</p>";
    }
    flushList();
    return html;
  }
  processInline(text) {
    text = this.escapeHTML(text);
    text = text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
    text = text.replace(/`(.+?)`/g, "<code>$1</code>");
    return text;
  }
  escapeHTML(text) {
    const map = {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;"
    };
    return text.replace(/[&<>"']/g, (m) => map[m]);
  }
  async copyToClipboard() {
    if (!this.cachedMarkdown) {
      new import_obsidian.Notice("\u6CA1\u6709\u53EF\u590D\u5236\u7684\u5185\u5BB9");
      return;
    }
    const style = STYLES[this.currentStyle];
    if (!style) {
      new import_obsidian.Notice("\u672A\u627E\u5230\u6837\u5F0F");
      return;
    }
    const htmlContent = this.convertMarkdownToHTMLOnly(this.cachedMarkdown);
    const scopedCSS = style.css.replace(/body\s*\{/g, ".mdskill-preview {").replace(/\bh1\s*\{/g, ".mdskill-preview h1 {").replace(/\bh2\s*\{/g, ".mdskill-preview h2 {").replace(/\bh3\s*\{/g, ".mdskill-preview h3 {").replace(/\bh4\s*\{/g, ".mdskill-preview h4 {").replace(/\bh5\s*\{/g, ".mdskill-preview h5 {").replace(/\bh6\s*\{/g, ".mdskill-preview h6 {").replace(/\bp\s*\{/g, ".mdskill-preview p {").replace(/\bblockquote\s*\{/g, ".mdskill-preview blockquote {").replace(/\bcode\s*\{/g, ".mdskill-preview code {").replace(/\bpre\s*\{/g, ".mdskill-preview pre {").replace(/\bul\s*\{/g, ".mdskill-preview ul {").replace(/\bol\s*\{/g, ".mdskill-preview ol {").replace(/\bli\s*\{/g, ".mdskill-preview li {").replace(/\ba\s*\{/g, ".mdskill-preview a {").replace(/\bimg\s*\{/g, ".mdskill-preview img {").replace(/\bhr\s*\{/g, ".mdskill-preview hr {").replace(/\bstrong\s*\{/g, ".mdskill-preview strong {").replace(/\bem\s*\{/g, ".mdskill-preview em {");
    const fullHTML = `<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>\u5FAE\u4FE1\u516C\u4F17\u53F7</title>
<style>${scopedCSS}</style>
</head>
<body>
<div class="mdskill-preview">${htmlContent}</div>
</body>
</html>`;
    try {
      await navigator.clipboard.writeText(fullHTML);
      new import_obsidian.Notice("\u2713 \u5DF2\u590D\u5236\u5230\u526A\u8D34\u677F\uFF0C\u53EF\u76F4\u63A5\u7C98\u8D34\u5230\u516C\u4F17\u53F7\u7F16\u8F91\u5668");
    } catch (err) {
      new import_obsidian.Notice("\u590D\u5236\u5931\u8D25\uFF1A" + err);
    }
  }
  async exportHTML() {
    if (!this.cachedMarkdown) {
      new import_obsidian.Notice("\u6CA1\u6709\u53EF\u5BFC\u51FA\u7684\u5185\u5BB9");
      return;
    }
    const style = STYLES[this.currentStyle];
    if (!style) {
      new import_obsidian.Notice("\u672A\u627E\u5230\u6837\u5F0F");
      return;
    }
    const htmlContent = this.convertMarkdownToHTMLOnly(this.cachedMarkdown);
    const scopedCSS = style.css.replace(/body\s*\{/g, ".mdskill-preview {").replace(/\bh1\s*\{/g, ".mdskill-preview h1 {").replace(/\bh2\s*\{/g, ".mdskill-preview h2 {").replace(/\bh3\s*\{/g, ".mdskill-preview h3 {").replace(/\bh4\s*\{/g, ".mdskill-preview h4 {").replace(/\bh5\s*\{/g, ".mdskill-preview h5 {").replace(/\bh6\s*\{/g, ".mdskill-preview h6 {").replace(/\bp\s*\{/g, ".mdskill-preview p {").replace(/\bblockquote\s*\{/g, ".mdskill-preview blockquote {").replace(/\bcode\s*\{/g, ".mdskill-preview code {").replace(/\bpre\s*\{/g, ".mdskill-preview pre {").replace(/\bul\s*\{/g, ".mdskill-preview ul {").replace(/\bol\s*\{/g, ".mdskill-preview ol {").replace(/\bli\s*\{/g, ".mdskill-preview li {").replace(/\ba\s*\{/g, ".mdskill-preview a {").replace(/\bimg\s*\{/g, ".mdskill-preview img {").replace(/\bhr\s*\{/g, ".mdskill-preview hr {").replace(/\bstrong\s*\{/g, ".mdskill-preview strong {").replace(/\bem\s*\{/g, ".mdskill-preview em {");
    const fullHTML = `<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>\u5FAE\u4FE1\u516C\u4F17\u53F7</title>
<style>${scopedCSS}</style>
</head>
<body>
<div class="mdskill-preview">${htmlContent}</div>
</body>
</html>`;
    const blob = new Blob([fullHTML], { type: "text/html" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `wechat-${Date.now()}.html`;
    a.click();
    URL.revokeObjectURL(url);
    new import_obsidian.Notice("\u2713 HTML \u6587\u4EF6\u5DF2\u4E0B\u8F7D");
  }
};
var WeChatPublisherPlugin = class extends import_obsidian.Plugin {
  async onload() {
    await this.loadSettings();
    this.registerView(
      VIEW_TYPE_WECHAT_PREVIEW,
      (leaf) => new WeChatPreviewView(leaf, this)
    );
    this.addRibbonIcon("smartphone", "\u516C\u4F17\u53F7\u9884\u89C8", () => {
      this.activateView();
    });
    this.addCommand({
      id: "open-wechat-preview",
      name: "\u6253\u5F00\u516C\u4F17\u53F7\u9884\u89C8",
      callback: () => {
        this.activateView();
      }
    });
    this.addSettingTab(new WeChatPublisherSettingTab(this.app, this));
  }
  async activateView() {
    const { workspace } = this.app;
    let leaf = workspace.getLeavesOfType(VIEW_TYPE_WECHAT_PREVIEW)[0];
    if (!leaf) {
      const rightLeaf = workspace.getRightLeaf(false);
      if (rightLeaf) {
        await rightLeaf.setViewState({
          type: VIEW_TYPE_WECHAT_PREVIEW,
          active: true
        });
        leaf = rightLeaf;
      }
    }
    if (leaf) {
      workspace.revealLeaf(leaf);
    }
  }
  onunload() {
    this.app.workspace.detachLeavesOfType(VIEW_TYPE_WECHAT_PREVIEW);
  }
  async loadSettings() {
    this.settings = Object.assign({}, DEFAULT_SETTINGS, await this.loadData());
  }
  async saveSettings() {
    await this.saveData(this.settings);
  }
};
var WeChatPublisherSettingTab = class extends import_obsidian.PluginSettingTab {
  constructor(app, plugin) {
    super(app, plugin);
    this.plugin = plugin;
  }
  display() {
    const { containerEl } = this;
    containerEl.empty();
    containerEl.createEl("h2", { text: "Obsidian-MDskill \u8BBE\u7F6E" });
    new import_obsidian.Setting(containerEl).setName("\u9ED8\u8BA4\u6837\u5F0F").setDesc("\u9009\u62E9\u6253\u5F00\u9884\u89C8\u65F6\u7684\u9ED8\u8BA4\u6837\u5F0F").addDropdown((dropdown) => {
      Object.entries(STYLES).forEach(([key, style]) => {
        dropdown.addOption(key, style.name);
      });
      dropdown.setValue(this.plugin.settings.defaultStyle).onChange(async (value) => {
        this.plugin.settings.defaultStyle = value;
        await this.plugin.saveSettings();
      });
    });
    new import_obsidian.Setting(containerEl).setName("\u81EA\u52A8\u66F4\u65B0\u9884\u89C8").setDesc("\u7F16\u8F91\u65F6\u81EA\u52A8\u5237\u65B0\u9884\u89C8\uFF08\u5173\u95ED\u53EF\u63D0\u5347\u6027\u80FD\uFF09").addToggle((toggle) => toggle.setValue(this.plugin.settings.autoUpdate).onChange(async (value) => {
      this.plugin.settings.autoUpdate = value;
      await this.plugin.saveSettings();
    }));
  }
};
